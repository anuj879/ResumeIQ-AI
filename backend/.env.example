# Get a free key at https://aistudio.google.com/apikey (no billing required for the free tier)
GEMINI_API_KEY=your_key_here
# Free-tier text models verified on Google's pricing page: gemini-3.8-flash, gemini-3.6-flash,
# gemini-3.5-flash-lite, gemini-3.1-flash-lite. If you hit quota limits, try gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.8-flash
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
AI_TIMEOUT_MS=60000
RATE_LIMIT_PER_MIN=30
